# ── Python 运行产物 ──
__pycache__/
*.py[cod]
*.pyo
*.spec
build/
dist/

# ── 虚拟环境 ──
.venv/
venv/
env/

# ── 运行时生成的用户配置（程序首次运行自动创建）──
windows-x64/config.json
windows-win7/app/config.json
kylin/**/config.json

# ── 可执行文件：通过 GitHub Releases 分发，不入库 ──
*.exe

# ── 麒麟版离线依赖（约 700MB，通过 Release 分发）──
kylin/**/wheels/
kylin/**/runtime/
kylin/**/*.zip
kylin/**/启动日志.txt

# ── 转换输出与测试中间产物 ──
converted/
cli_out/
exe_out/
raw_*.docx
split_*.docx
转换日志.txt

# ── 编辑器与系统文件 ──
.idea/
.vscode/
*.log
Thumbs.db
desktop.ini
.DS_Store
~$*
